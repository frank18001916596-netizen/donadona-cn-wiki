\u7b49\u7ea7\u57fa\u51c6\u6570\u636e EVENT\u89d2\u8272\u4e8b\u4ef6 \u4e8b\u4ef6\u6761\u4ef6\u7ed3\u679c\u5907\u6ce8 Feeling / \u4e2a\u4eba\u4e8b\u4ef6\u968f\u5267\u60c5\u4e0e Feeling \u63a8\u8fdb\u6280\u80fd / \u5267\u60c5 / \u56de\u60f3\u7b49\u7cbe\u786e\u8282\u70b9\u5f85\u4e8b\u4ef6\u6570\u636e\u5e93\u5f55\u5165 STORY\u5267\u60c5\u8d44\u6599 \u9996\u6b21\u767b\u573a\u5f85\u4e3b\u7ebf\u6d41\u7a0b\u6570\u636e\u5e93\u5173\u8054 \u52a0\u5165\u6761\u4ef6NAYUTA \u6210\u5458\uff1b\u7cbe\u786e\u6d41\u7a0b\u8282\u70b9\u5f85\u6838\u5b9e \u4e2a\u4eba\u5267\u60c5\u540e\u7eed\u94fe\u63a5\u81f3\u4e8b\u4ef6\u9875\u9762 \u7ed3\u5c40\u6761\u4ef6\u6d89\u53ca\u8def\u7ebf\u5267\u900f\uff0c\u540e\u7eed\u5355\u72ec\u6574\u7406 GALLERY\u5b98\u65b9\u8868\u60c5 / \u5dee\u5206 EXPRESSION 01EXPRESSION 02EXPRESSION 03EXPRESSION 04EXPRESSION 05 PLAYER TIPS\u73a9\u5bb6\u63d0\u793a <p>\u672c\u9875\u628a\u201c\u5df2\u6838\u5b9e\u6570\u636e\u201d\u548c\u201c\u5f85\u6838\u5b9e\u6570\u636e\u5e93\u5b57\u6bb5\u201d\u5206\u5f00\u663e\u793a\u3002\u653b\u7565\u5efa\u8bae\u5c5e\u4e8e\u73a9\u5bb6\u5411\u603b\u7ed3\uff0c\u4e0d\u4f5c\u4e3a\u5b98\u65b9\u8bbe\u5b9a\u3002</p>"},{"location":"characters/nayuta/kuma/","title":"Index","text":"\u2190 NAYUTA / \u8fd4\u56de\u6210\u5458 FACTIONS / \u8fd4\u56de\u9635\u8425 KUMA \u2190 NAYUTA MEMBERS <p>NAYUTA // CHARACTER DATABASE</p> KUMA / \u30af\u30de \u67aa\u51fb\u8fd1\u6218\u7206\u53d1\u4e2d\u8fdc\u7a0b\u8865\u5200POW\u652f\u63f4Feeling\u8054\u52a8 <p>\u7ecf\u5e38\u88ab\u63a8\u53bb\u5904\u7406\u9ebb\u70e6\u4e8b\u3001\u5403\u4e8f\u7684 No.2\u3002\u6027\u683c\u8ba4\u771f\u4f4e\u8c03\uff0c\u4e0e NAYUTA \u7684\u968f\u6027\u6c14\u6c1b\u5e76\u4e0d\u76f8\u79f0\uff0c\u5374\u610f\u5916\u5730\u80fd\u8ba9\u56e2\u961f\u6b63\u5e38\u8fd0\u8f6c\u3002</p> NAME\u30af\u30de / KUMA CLANNAYUTA / \u30ca\u30e6\u30bf ROLE\u4e3b\u4eba\u516c / NAYUTA No.2 BIRTHDAY2\u670810\u65e5 BLOODA\u578b CV\u4e3b\u4eba\u516c\u65e0\u8bed\u97f3 QUICK INFO\u5feb\u901f\u5b9a\u4f4d \u67aa\u51fb\u8fd1\u6218\u7206\u53d1\u4e2d\u8fdc\u7a0b\u8865\u5200POW\u652f\u63f4Feeling\u8054\u52a8 <p>\u4ee5\u67aa\u51fb\u4e3a\u6838\u5fc3\u7684\u591a\u7528\u9014\u89d2\u8272\u3002\u8ddd\u79bb 1 \u7684\u300c\u63a5\u5c04\u300d\u8d1f\u8d23\u9ad8\u500d\u7387\u8fd1\u6218\u7206\u53d1\uff0c\u8ddd\u79bb 4 \u7684\u300c\u767a\u7832\uff0f\u4e71\u5c04\u300d\u8865\u8db3\u4e2d\u8fdc\u8ddd\u79bb\uff1b\u540e\u671f\u300c\u5408\u7406\u6226\u8853\u300d\u53ef\u5f3a\u5316\u8eab\u540e\u53cb\u519b POW\u3002</p> BATTLE\u6218\u6597\u98ce\u683c \u8fd1\u8ddd\u79bb\u7206\u53d195 \u4e2d\u8fdc\u7a0b65 \u7fa4\u4f53\u5904\u740655 \u961f\u4f0d\u652f\u63f480 WEAPON\u6b66\u5668 \u67aa\u68b0 <p>\u4f18\u5148\u670d\u52a1\u4e8e\u9ad8 POW \u7684\u300c\u63a5\u5c04\u300d\u7206\u53d1\uff1b\u9700\u8981\u6253\u8fdc\u8ddd\u79bb\u65f6\u518d\u5207\u6362\u5230\u767a\u7832\uff0f\u4e71\u5c04\u3002\u5177\u4f53 R1\u2013R6 \u6b66\u5668\u540d\u79f0\u4e0e\u7d20\u6750\u8868\u5efa\u8bae\u540e\u7eed\u4ece\u6e38\u620f\u5185\u6216\u6b66\u5668\u6570\u636e\u5e93\u9010\u9879\u6838\u5bf9\u3002</p> SKILLS\u6280\u80fd\u6570\u636e\u5e93 \u6280\u80fd\u7c7b\u578b\u89e3\u9501MP / COST\u5c04\u7a0b / \u8303\u56f4\u6548\u679c \u30d5\u30a3\u30fc\u30ea\u30f3\u30b0\u88ab\u52a8\u521d\u59cb\u2014\u2014\u4e0e\u81ea\u5df1\u4e00\u540c\u5728\u524d\u536b\u7684\u6210\u5458\uff0c\u6218\u6597\u540e Feeling +40 \u30ea\u30fc\u30c7\u30a3\u30f3\u30b0\u88ab\u52a8F 10000\u2014\u2014\u884c\u52a8\u5f00\u59cb\u65f6\u4f9d\u636e\u524d\u536b\u6210\u5458\u7684 Feeling \u7b49\u7ea7\u56de\u590d MP \u63a5\u5c04\u67aa\u51fb\u521d\u59cb14*1 / \u5355\u4f53POW 140% \u767a\u7832\u67aa\u51fbLv.4184 / \u5355\u4f53POW 60% \u4e71\u5c04\u67aa\u51fbLv.34204 / \u90bb\u63a5POW 40% \u5408\u7406\u6226\u8853\u652f\u63f4Lv.4512\u540e\u65b9\u5168\u4f53\u8eab\u540e\u53cb\u519b POW +40% \u7d44\u307f\u6483\u3061\u67aa\u51fb / VP\u4e0e\u30dd\u30eb\u30ce\u76f8\u5173\u6761\u4ef6VP1 / \u5355\u4f53POW 260% GUIDE\u4f7f\u7528\u653b\u7565 \u63a8\u8350\u6253\u6cd5<ul><li>\u63a5\u5c04\u500d\u7387\u9ad8\uff0c\u4f46\u8ddd\u79bb\u53ea\u6709 1\uff1b\u7ad9\u4f4d\u51b3\u5b9a\u8f93\u51fa\u4e0a\u9650\u3002</li><li>Lv.45 \u540e\u5408\u7406\u6226\u8853\u8ba9 KUMA \u517c\u5177\u8f93\u51fa\u4e0e\u540e\u6392\u589e\u4f24\u4ef7\u503c\u3002</li><li>Feeling \u88ab\u52a8\u8ba9\u4ed6\u5728\u957f\u671f\u57f9\u517b\u4e2d\u5177\u6709\u72ec\u7279\u529f\u80fd\u3002</li></ul> \u6ce8\u610f / \u5f31\u70b9<ul><li>\u6838\u5fc3\u7206\u53d1\u5c04\u7a0b\u77ed\u3002</li><li>\u4e71\u5c04\u500d\u7387\u8f83\u4f4e\uff0c\u66f4\u9002\u5408\u8865\u5200\u800c\u975e\u4e3b\u529b AOE\u3002</li><li>\u90e8\u5206 Boss \u7ad9\u4f4d\u4f1a\u9650\u5236\u63a5\u5c04\u53d1\u6325\u3002</li></ul> BUILD\u517b\u6210\u65b9\u5411 \u6b66\u5668 R1\u2013R6\u5f85\u6b66\u5668\u6570\u636e\u5e93\u6838\u5b9e \u63a8\u8350 Badge\u5f85\u5b9e\u6218\u6570\u636e\u6838\u5b9e \u57fa\u7840\u5c5e\u6027\u5f85\u5f55\u5165\u7b49\u7ea7\u57fa\u51c6\u6570\u636e EVENT\u89d2\u8272\u4e8b\u4ef6 \u4e8b\u4ef6\u6761\u4ef6\u7ed3\u679c\u5907\u6ce8 Feeling / \u4e2a\u4eba\u4e8b\u4ef6\u968f\u5267\u60c5\u4e0e Feeling \u63a8\u8fdb\u6280\u80fd / \u5267\u60c5 / \u56de\u60f3\u7b49\u7cbe\u786e\u8282\u70b9\u5f85\u4e8b\u4ef6\u6570\u636e\u5e93\u5f55\u5165 STORY\u5267\u60c5\u8d44\u6599 \u9996\u6b21\u767b\u573a\u5f85\u4e3b\u7ebf\u6d41\u7a0b\u6570\u636e\u5e93\u5173\u8054 \u52a0\u5165\u6761\u4ef6NAYUTA \u6210\u5458\uff1b\u7cbe\u786e\u6d41\u7a0b\u8282\u70b9\u5f85\u6838\u5b9e \u4e2a\u4eba\u5267\u60c5\u540e\u7eed\u94fe\u63a5\u81f3\u4e8b\u4ef6\u9875\u9762 \u7ed3\u5c40\u6761\u4ef6\u6d89\u53ca\u8def\u7ebf\u5267\u900f\uff0c\u540e\u7eed\u5355\u72ec\u6574\u7406 GALLERY\u5b98\u65b9\u8868\u60c5 / \u5dee\u5206 EXPRESSION 01EXPRESSION 02EXPRESSION 03EXPRESSION 04EXPRESSION 05 PLAYER TIPS\u73a9\u5bb6\u63d0\u793a <p>\u672c\u9875\u628a\u201c\u5df2\u6838\u5b9e\u6570\u636e\u201d\u548c\u201c\u5f85\u6838\u5b9e\u6570\u636e\u5e93\u5b57\u6bb5\u201d\u5206\u5f00\u663e\u793a\u3002\u653b\u7565\u5efa\u8bae\u5c5e\u4e8e\u73a9\u5bb6\u5411\u603b\u7ed3\uff0c\u4e0d\u4f5c\u4e3a\u5b98\u65b9\u8bbe\u5b9a\u3002</p>"},{"location":"characters/nayuta/porno/","title":"Index","text":"\u2190 NAYUTA / \u8fd4\u56de\u6210\u5458 FACTIONS / \u8fd4\u56de\u9635\u8425 PORNO \u2190 NAYUTA MEMBERS <p>NAYUTA // CHARACTER DATABASE</p> PORNO / \u30dd\u30eb\u30ce Debuff\u9ad8\u901f\u884c\u52a8\u5f31\u5316\u654c\u4eba\u8f85\u52a9\u8f93\u51fa <p>KUMA \u7684\u524d\u8f88\uff0c\u5e76\u8d1f\u8d23\u4e00\u4e9b\u7279\u6b8a\u7684\u201c\u6307\u5bfc\u201d\u3002\u5b98\u65b9\u89d2\u8272\u8bbe\u5b9a\u9875\u4e2d\u5df2\u786e\u8ba4\u5176 NAYUTA \u8eab\u4efd\uff1b\u751f\u65e5\u4e0e\u8840\u578b\u76ee\u524d\u672a\u4ece\u73b0\u6709\u5b98\u65b9\u8d44\u6599\u4e2d\u786e\u8ba4\u3002</p> NAME\u30dd\u30eb\u30ce / PORNO CLANNAYUTA / \u30ca\u30e6\u30bf ROLENAYUTA Member / KUMA \u7684\u524d\u8f88 BIRTHDAY\u2014 BLOOD\u2014 CV\u6771\u30b7\u30c5 \u266a VOICE 01 \u266a VOICE 02 \u266a VOICE 03 QUICK INFO\u5feb\u901f\u5b9a\u4f4d Debuff\u9ad8\u901f\u884c\u52a8\u5f31\u5316\u654c\u4eba\u8f85\u52a9\u8f93\u51fa <p>\u653b\u7565\u8d44\u6599\u666e\u904d\u5c06 PORNO \u63cf\u8ff0\u4e3a Debuffer\uff1a\u4f9d\u9760\u8f83\u9ad8\u884c\u52a8\u901f\u5ea6\u4e0e POW \u5f31\u5316\u5e72\u6270\u654c\u65b9\uff0c\u4f46\u8010\u4e45\u4e0e\u76f4\u63a5\u4f24\u5bb3\u5e76\u975e\u4e3b\u8981\u4f18\u52bf\u3002</p> BATTLE\u6218\u6597\u98ce\u683c Debuff94 \u884c\u52a8\u901f\u5ea690 \u76f4\u63a5\u8f93\u51fa48 \u751f\u5b58\u80fd\u529b42 WEAPON\u6b66\u5668 \u5f85\u6838\u5b9e <p>\u5148\u4fdd\u7559\u6570\u636e\u5e93\u5b57\u6bb5\u3002\u6b66\u5668\u7c7b\u578b\u3001R1\u2013R6 \u540d\u79f0\u3001\u7d20\u6750\u4e0e\u6570\u503c\u9700\u8981\u8fdb\u4e00\u6b65\u6838\u5bf9\u3002</p> SKILLS\u6280\u80fd\u6570\u636e\u5e93 \u6280\u80fd\u7c7b\u578b\u89e3\u9501MP / COST\u5c04\u7a0b / \u8303\u56f4\u6548\u679c \u6280\u80fd\u6570\u636e\u5f85\u6838\u5b9e\u2014\u2014\u2014\u672c\u7248\u4e0d\u51ed\u5370\u8c61\u586b\u6570\u503c\uff1b\u540e\u7eed\u4ece\u6e38\u620f\u5185/\u53ef\u9760\u6280\u80fd\u8868\u8865\u9f50\u5b8c\u6574\u6280\u80fd\u3002 GUIDE\u4f7f\u7528\u653b\u7565 \u63a8\u8350\u6253\u6cd5<ul><li>\u6838\u5fc3\u4ef7\u503c\u5728\u5f31\u5316\u654c\u65b9\uff0c\u800c\u4e0d\u662f\u4e0e\u7eaf\u8f93\u51fa\u89d2\u8272\u62fc\u500d\u7387\u3002</li><li>\u9ad8\u901f\u53ef\u7528\u4e8e\u4ea4\u4ee3\u3001\u9053\u5177\u548c Debuff \u8282\u594f\u3002</li><li>\u9762\u5bf9\u9ad8\u5a01\u80c1\u76ee\u6807\u65f6\uff0cPOW Debuff \u7684\u4ef7\u503c\u4f1a\u9ad8\u4e8e\u6e05\u6742\u3002</li></ul> \u6ce8\u610f / \u5f31\u70b9<ul><li>\u8010\u4e45\u504f\u4f4e\u3002</li><li>Debuff \u7684\u6536\u76ca\u53d7\u6218\u6597\u8282\u594f\u4e0e\u6210\u529f\u7387\u5f71\u54cd\u3002</li><li>\u73b0\u9636\u6bb5\u6280\u80fd\u7cbe\u786e\u6570\u503c\u4ecd\u5f85\u6838\u5bf9\u3002</li></ul> BUILD\u517b\u6210\u65b9\u5411 \u6b66\u5668 R1\u2013R6\u5f85\u6b66\u5668\u6570\u636e\u5e93\u6838\u5b9e \u63a8\u8350 Badge\u5f85\u5b9e\u6218\u6570\u636e\u6838\u5b9e \u57fa\u7840\u5c5e\u6027\u5f85\u5f55\u5165\u7b49\u7ea7\u57fa\u51c6\u6570\u636e EVENT\u89d2\u8272\u4e8b\u4ef6 \u4e8b\u4ef6\u6761\u4ef6\u7ed3\u679c\u5907\u6ce8 Feeling / \u4e2a\u4eba\u4e8b\u4ef6\u968f\u5267\u60c5\u4e0e Feeling \u63a8\u8fdb\u6280\u80fd / \u5267\u60c5 / \u56de\u60f3\u7b49\u7cbe\u786e\u8282\u70b9\u5f85\u4e8b\u4ef6\u6570\u636e\u5e93\u5f55\u5165 STORY\u5267\u60c5\u8d44\u6599 \u9996\u6b21\u767b\u573a\u5f85\u4e3b\u7ebf\u6d41\u7a0b\u6570\u636e\u5e93\u5173\u8054 \u52a0\u5165\u6761\u4ef6NAYUTA \u6210\u5458\uff1b\u7cbe\u786e\u6d41\u7a0b\u8282\u70b9\u5f85\u6838\u5b9e \u4e2a\u4eba\u5267\u60c5\u540e\u7eed\u94fe\u63a5\u81f3\u4e8b\u4ef6\u9875\u9762 \u7ed3\u5c40\u6761\u4ef6\u6d89\u53ca\u8def\u7ebf\u5267\u900f\uff0c\u540e\u7eed\u5355\u72ec\u6574\u7406 GALLERY\u5b98\u65b9\u8868\u60c5 / \u5dee\u5206 EXPRESSION 01EXPRESSION 02EXPRESSION 03EXPRESSION 04EXPRESSION 05 PLAYER TIPS\u73a9\u5bb6\u63d0\u793a <p>\u672c\u9875\u628a\u201c\u5df2\u6838\u5b9e\u6570\u636e\u201d\u548c\u201c\u5f85\u6838\u5b9e\u6570\u636e\u5e93\u5b57\u6bb5\u201d\u5206\u5f00\u663e\u793a\u3002\u653b\u7565\u5efa\u8bae\u5c5e\u4e8e\u73a9\u5bb6\u5411\u603b\u7ed3\uff0c\u4e0d\u4f5c\u4e3a\u5b98\u65b9\u8bbe\u5b9a\u3002</p>"},{"location":"characters/nayuta/torataro/","title":"Index","text":"\u2190 NAYUTA / \u8fd4\u56de\u6210\u5458 FACTIONS / \u8fd4\u56de\u9635\u8425 TORATARO \u2190 NAYUTA MEMBERS <p>NAYUTA // CHARACTER DATABASE</p> TORATARO / \u864e\u592a\u90ce \u591a\u5c04\u7a0b\u7535/\u7279\u6b8a\u8f93\u51fa\u9632\u5fa1\u59ff\u6001KUMA\u8054\u52a8VP\u7206\u53d1 <p>\u628a KUMA \u5f53\u4f5c\u7ade\u4e89\u5bf9\u624b\u3001\u81ea\u79f0 NAYUTA No.2\u3002\u64c5\u957f\u673a\u68b0\u5de5\u4f5c\uff0c\u4e5f\u4f1a\u81ea\u5df1\u5236\u4f5c\u6b66\u5668\uff1b\u672c\u4eba\u5f88\u60f3\u5c3d\u5feb\u6446\u8131\u201c\u864e\u592a\u90ce\u201d\u8fd9\u4e2a\u79f0\u547c\u3002</p> NAME\u864e\u592a\u90ce / TORATARO CLANNAYUTA / \u30ca\u30e6\u30bf ROLE\u81ea\u79f0 NAYUTA No.2 / \u673a\u68b0\u8fbe\u4eba BIRTHDAY8\u67088\u65e5 BLOODB\u578b CV\u8c37\u6839\u5343 \u266a VOICE 01 \u266a VOICE 02 \u266a VOICE 03 QUICK INFO\u5feb\u901f\u5b9a\u4f4d \u591a\u5c04\u7a0b\u7535/\u7279\u6b8a\u8f93\u51fa\u9632\u5fa1\u59ff\u6001KUMA\u8054\u52a8VP\u7206\u53d1 <p>\u62e5\u6709\u8ddd\u79bb 1\u30013\u30014 \u7684\u591a\u5c04\u7a0b\u653b\u51fb\uff0c\u5e76\u5177\u5907 DEF \u5f3a\u5316\u4e0e VP \u5fc5\u6740\u3002\u88ab\u52a8\u4e0e KUMA \u540c\u65f6\u5728\u524d\u536b\u65f6\u53ef\u63d0\u5347 SPD\u3002</p> BATTLE\u6218\u6597\u98ce\u683c \u5c04\u7a0b\u8986\u76d694 \u5355\u4f53\u8f93\u51fa82 \u9632\u5fa1\u5e94\u5bf984 KUMA\u8054\u52a888 WEAPON\u6b66\u5668 \u81ea\u5236\u673a\u68b0\u6b66\u5668 / \u53cc\u8282\u68cd\u7cfb <p>\u5b98\u65b9\u8bbe\u5b9a\u660e\u786e\u5176\u64c5\u957f\u673a\u68b0\u5de5\u4f5c\u5e76\u81ea\u5236\u6b66\u5668\uff1b\u653b\u7565\u6280\u80fd\u8868\u53ef\u786e\u8ba4\u53cc\u8282\u68cd\u7b49\u8868\u73b0\u3002R1\u2013R6 \u6b63\u5f0f\u6b66\u5668\u8868\u4ecd\u5f85\u6838\u5b9e\u3002</p> SKILLS\u6280\u80fd\u6570\u636e\u5e93 \u6280\u80fd\u7c7b\u578b\u89e3\u9501MP / COST\u5c04\u7a0b / \u8303\u56f4\u6548\u679c \u30d0\u30fc\u30cb\u30f3\u30e9\u30a4\u30d0\u30eb\u88ab\u52a8\u521d\u59cb\u2014\u2014\u4e0e KUMA \u540c\u5728\u524d\u536b\u65f6 SPD +40%\uff1b\u53d1\u52a8\u6982\u7387\u4e0e TEC \u6709\u5173 \u30a2\u30f3\u30b0\u30ea\u30fc\u30bf\u30a4\u30ac\u30fc\u88ab\u52a8F 5000\u2014\u2014HP \u4f4e\u4e8e 20% \u65f6\uff0c\u884c\u52a8\u5f00\u59cb VP +20 \u9f8d\u53cc\u622a\u653b\u51fb\u521d\u59cb81 / \u5355\u4f53POW 60%\uff0c\u53cc\u8282\u68cd\u653b\u51fb \u9023\u69cd\u5203\u4e71\u6960\u653b\u51fb\u521d\u59cb103 / \u5355\u4f53POW 100%\uff0c\u8fde\u7eed\u7a81\u523a \u5f6a\u7259\u7a7f\u68cd\u653b\u51fbLv.28204 / \u5355\u4f53POW 120% \u660e\u93e1\u65cb\u8f2a\u9632\u5fa1Lv.3914\u81ea\u8eabDEF +80% \u30a2\u30bb\u30c1\u30ec\u30f3\u30d0\u30fc\u30ca\u30fcVPF 1000VP2 / \u90bb\u63a5POW 240% GUIDE\u4f7f\u7528\u653b\u7565 \u63a8\u8350\u6253\u6cd5<ul><li>\u5c04\u7a0b\u8986\u76d6\u4f18\u79c0\uff0c\u53ef\u4ee5\u6839\u636e\u654c\u4eba\u8ddd\u79bb\u8c03\u6574\u6280\u80fd\u3002</li><li>\u4e0e KUMA \u540c\u524d\u536b\u53ef\u5229\u7528\u30d0\u30fc\u30cb\u30f3\u30e9\u30a4\u30d0\u30eb\u63d0\u5347 SPD\u3002</li><li>\u660e\u93e1\u65cb\u8f2a\u9002\u5408\u9700\u8981\u9876\u4f4f\u9ad8\u4f24\u5bb3\u7684\u573a\u5408\u3002</li></ul> \u6ce8\u610f / \u5f31\u70b9<ul><li>\u90e8\u5206\u5173\u952e\u6280\u80fd\u8981\u5230\u4e2d\u540e\u671f\u624d\u89e3\u9501\u3002</li><li>\u88ab\u52a8\u5b58\u5728 TEC \u6982\u7387\u6761\u4ef6\u3002</li><li>\u4f4e HP \u89e6\u53d1\u578b\u88ab\u52a8\u9700\u8981\u63a7\u5236\u98ce\u9669\u3002</li></ul> BUILD\u517b\u6210\u65b9\u5411 \u6b66\u5668 R1\u2013R6\u5f85\u6b66\u5668\u6570\u636e\u5e93\u6838\u5b9e \u63a8\u8350 Badge\u5f85\u5b9e\u6218\u6570\u636e\u6838\u5b9e \u57fa\u7840\u5c5e\u6027\u5f85\u5f55\u5165\u7b49\u7ea7\u57fa\u51c6\u6570\u636e EVENT\u89d2\u8272\u4e8b\u4ef6 \u4e8b\u4ef6\u6761\u4ef6\u7ed3\u679c\u5907\u6ce8 Feeling / \u4e2a\u4eba\u4e8b\u4ef6\u968f\u5267\u60c5\u4e0e Feeling \u63a8\u8fdb\u6280\u80fd / \u5267\u60c5 / \u56de\u60f3\u7b49\u7cbe\u786e\u8282\u70b9\u5f85\u4e8b\u4ef6\u6570\u636e\u5e93\u5f55\u5165 STORY\u5267\u60c5\u8d44\u6599 \u9996\u6b21\u767b\u573a\u5f85\u4e3b\u7ebf\u6d41\u7a0b\u6570\u636e\u5e93\u5173\u8054 \u52a0\u5165\u6761\u4ef6NAYUTA \u6210\u5458\uff1b\u7cbe\u786e\u6d41\u7a0b\u8282\u70b9\u5f85\u6838\u5b9e \u4e2a\u4eba\u5267\u60c5\u540e\u7eed\u94fe\u63a5\u81f3\u4e8b\u4ef6\u9875\u9762 \u7ed3\u5c40\u6761\u4ef6\u6d89\u53ca\u8def\u7ebf\u5267\u900f\uff0c\u540e\u7eed\u5355\u72ec\u6574\u7406 GALLERY\u5b98\u65b9\u8868\u60c5 / \u5dee\u5206 EXPRESSION 01EXPRESSION 02EXPRESSION 03EXPRESSION 04EXPRESSION 05 PLAYER TIPS\u73a9\u5bb6\u63d0\u793a <p>\u672c\u9875\u628a\u201c\u5df2\u6838\u5b9e\u6570\u636e\u201d\u548c\u201c\u5f85\u6838\u5b9e\u6570\u636e\u5e93\u5b57\u6bb5\u201d\u5206\u5f00\u663e\u793a\u3002\u653b\u7565\u5efa\u8bae\u5c5e\u4e8e\u73a9\u5bb6\u5411\u603b\u7ed3\uff0c\u4e0d\u4f5c\u4e3a\u5b98\u65b9\u8bbe\u5b9a\u3002</p>"},{"location":"characters/nayuta/zappa/","title":"Index","text":"\u2190 NAYUTA / \u8fd4\u56de\u6210\u5458 FACTIONS / \u8fd4\u56de\u9635\u8425 ZAPPA \u2190 NAYUTA MEMBERS <p>NAYUTA // CHARACTER DATABASE</p> ZAPPA / \u30b6\u30c3\u30d1 \u6253\u5c5e\u6027\u524d\u6392\u627f\u4f24VP\u652f\u63f4\u4e2d\u540e\u671f\u8f93\u51fa <p>\u8c6a\u653e\u78ca\u843d\u7684 NAYUTA \u9886\u8896\u3002\u6bcf\u5929\u60f3\u7740\u600e\u4e48\u628a\u65e5\u5b50\u8fc7\u5f97\u5f00\u5fc3\uff0c\u751a\u81f3\u53ef\u80fd\u8fde\u8fd9\u4ef6\u4e8b\u672c\u8eab\u90fd\u6ca1\u8ba4\u771f\u60f3\u3002</p> NAME\u30b6\u30c3\u30d1 / ZAPPA CLANNAYUTA / \u30ca\u30e6\u30bf ROLENAYUTA Leader BIRTHDAY1\u67085\u65e5 BLOODA\u578b CV\u91ce\u2606\u7403 \u266a VOICE 01 \u266a VOICE 02 \u266a VOICE 03 QUICK INFO\u5feb\u901f\u5b9a\u4f4d \u6253\u5c5e\u6027\u524d\u6392\u627f\u4f24VP\u652f\u63f4\u4e2d\u540e\u671f\u8f93\u51fa <p>\u504f\u524d\u6392\u7684\u6253\u5c5e\u6027\u89d2\u8272\uff0cHP \u4e0e\u9632\u5fa1\u5411\u88ab\u52a8\u8ba9\u4ed6\u9002\u5408\u627f\u62c5\u538b\u529b\uff1b\u540c\u65f6\u62e5\u6709\u8fd1\u4e2d\u8ddd\u79bb\u6253\u51fb\u3001\u90bb\u63a5\u653b\u51fb\u548c\u8fdc\u8ddd\u79bb VP \u6280\u3002</p> BATTLE\u6218\u6597\u98ce\u683c \u524d\u6392\u627f\u4f2492 \u8fd1\u4e2d\u8ddd\u79bb78 \u7fa4\u4f53\u5904\u7